# --- Mode -------------------------------------------------------------------
# "live" uses the providers below. "mock" needs no keys: the relay answers
# every press with a chirp and an echo of what the radio sent. Use mock to
# bring up new hardware.
ROGER_PROVIDER=live

# --- The model that writes Roger's replies -----------------------------------
ANTHROPIC_API_KEY=
# Any Claude model id. A small, fast model keeps the static short.
ROGER_LLM_MODEL=claude-haiku-5-5

# --- Speech to text and text to speech ---------------------------------------
# Any server that implements the OpenAI-style /audio/transcriptions and
# /audio/speech endpoints, hosted or self-hosted. Text to speech must support
# response_format "pcm" (24 kHz, 16-bit, mono).
ROGER_AUDIO_BASE_URL=https://api.openai.com/v1
ROGER_AUDIO_API_KEY=
ROGER_STT_MODEL=gpt-4o-mini-transcribe
ROGER_TTS_MODEL=gpt-4o-mini-tts
ROGER_TTS_VOICE=cedar
# Optional. Leave unset to use the built-in direction; ignored by servers that
# do not support it.
# ROGER_TTS_INSTRUCTIONS=
# Optional ISO-639-1 hint for transcription, e.g. "en".
# ROGER_LANGUAGE=en

# --- Server -------------------------------------------------------------------
# ROGER_ADDR=:8080
# ROGER_DATA_DIR=./data
# ROGER_DEVICES=./devices.json

# --- Daily digest email (optional) -------------------------------------------
# Leave SMTP_HOST empty to disable sending. `roger-relay digest` still renders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
